{
  "name": "kicktv-webos-poc",
  "version": "0.1.0",
  "private": true,
  "description": "PoC experimental: embed oficial Kick e diagnóstico HLS nativo no webOS",
  "scripts": {
    "test": "node --test tests/channel.test.js && playwright test",
    "test:unit": "node --test tests/channel.test.js",
    "test:browser": "playwright test",
    "package": "ares-package --no-minify app -o dist",
    "package:info": "ares-package --info-detail dist/com.kicktv.poc_0.1.0_all.ipk"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@webos-tools/cli": "3.2.6"
  }
}
