{
  "name": "kicktv-alpha",
  "version": "0.2.6",
  "private": true,
  "description": "KickTV Alpha: Direct HLS e chat somente leitura para webOS",
  "scripts": {
    "validate": "node scripts/validate.cjs",
    "test": "npm run test:unit && npm run test:chat && playwright test",
    "test:unit": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "package": "npm run validate && node scripts/package.cjs",
    "package:info": "node scripts/package.cjs --info",
    "test:chat": "node --test tests/chat/*.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@webos-tools/cli": "3.2.6"
  }
}
